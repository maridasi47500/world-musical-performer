  Parameters: {"authenticity_token" => "[FILTERED]", "clip" => {"title" => "hey", "link" => "JHR621HkzQo"}, "commit" => "Create Clip"}
  [1m[36mTRANSACTION (0.3ms)[0m  [1m[36mBEGIN immediate TRANSACTION[0m
  ↳ app/models/clip.rb:15:in 'Clip#myfunc'
  [1m[36mArtist Load (9.5ms)[0m  [1m[34mSELECT "artists".* FROM "artists" WHERE "artists"."name" = ? LIMIT ?[0m  [["name", "hey"], ["LIMIT", 1]]
