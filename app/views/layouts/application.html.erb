<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Google Look-Alike</title>
  <link rel="stylesheet" href="styles.css">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%#= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">

<style>

.allclips {
	height: 300px;
    width:100%;
	text-align: center;
	padding-left: 100px;
	margin-bottom: 100px;
}
div.sub, iframe, #player-controls {
    width: 467px;
	text-align: center;
    height: 265px;
    margin: 0 auto;
    float: left;
    clear: both;
}
div.sub {
	width: 100%;
}
.picartist {
	position: relative;
	width: min-content;
}
.picartist span {
	position: absolute;
	left: 0;
	bottom: 0;
	font-size: 42px;
	text-align: center;
	width: 100%;
  -webkit-text-stroke: 2px green;
}

td.contentpic {
		width:100%;
}
td.contentpic * {
  float:left;
}
td.mytitle {
	width:100px;
}

td {
	border: 1px solid;
}

</style>
  </head>

  <body>
<%=link_to "chercher une pièce de musique au hasard", MusicalPiece.all.sample%>
<%=link_to "welcome", root_path%>
<%=link_to "videos", clips_path%>
<%=link_to "scores", scores_path%>
<%=link_to "pics", pics_path%>
<%=link_to "ajouter un nouveau clip", "", onclick: "on();return false;"%>

 <style>
#text{
  position: absolute;
  top: 30%;
  left: 50%;
  font-size: 40px;
  color: white;
  width: 50%;height:50%;
  transform: translate(-50%,-50%);
  -ms-transform: translate(-50%,-50%);
  background: black;
}
      #overlay {
  position: fixed; /* Sit on top of the page content */
  display: none; /* Hidden by default */
  width: 100%; /* Full width (cover the whole page) */
  height: 100%; /* Full height (cover the whole page) */
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5); /* Black background with opacity */
  z-index: 2; /* Specify a stack order in case you're using a different order for other elements */
  cursor: pointer; /* Add a pointer on hover */
}
</style>
<!-- onclick="(overlay.dataset.mydata === '0' ? off() : console.log(''));return false;" --> 
<div id="overlay"   data-mydata="0">
  <div id="text" onmouseleave="overlay.dataset.mydata='0';return false;" onmouseenter="overlay.dataset.mydata='1';return false;">
    ajoute un nouveau clip <span onclick="off(); return false;">[X] fermer</span>

    <%= render "clips/form1", clip: Clip.new %>

    </div>
</div>
  <script>
     function on() {
  document.getElementById("overlay").style.display = "block";
}

function off() {
  document.getElementById("overlay").style.display = "none";
  overlay.dataset.mydata='0';
}
  </script>
<hr>
    <%= yield %>
    <script src="https://code.jquery.com/jquery-4.0.0.js" integrity="sha256-9fsHeVnKBvqh3FB2HYu7g2xseAZ5MlN6Kz/qnkASV8U=" crossorigin="anonymous"></script>
<script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
</body>
</html>

